# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# ---- Supabase ----
# Lấy ở Supabase Dashboard → Project Settings → API Keys.
# Code chấp nhận CẢ tên mới (sb_pub_/sb_secret_) lẫn tên cũ (anon/service_role).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable / anon key (public, dùng được ở client). Chỉ cần 1 trong 2 tên:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_pub_your-key-here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ-your-legacy-anon-key

# Secret / service_role key (server-only, bypass RLS). Chỉ cần 1 trong 2 tên:
SUPABASE_SECRET_KEY=sb_secret_your-key-here
# SUPABASE_SERVICE_ROLE_KEY=eyJ-your-legacy-service-role-key

# ---- OpenAI ----
OPENAI_API_KEY=sk-your-openai-key-here

# ---- Google Places API (New) ----
# Restrict in Google Cloud Console: API → "Places API (New)" only; Application → IP-restricted.
GOOGLE_PLACES_API_KEY=your-google-places-key-here

# ---- Optional: dev flags ----
# Set true to use seeded sample reviews instead of calling Google API
USE_SAMPLE_DATA=false
